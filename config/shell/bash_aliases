# Managed by dev-env through mise bootstrap dotfiles.

proxy() {
    if (( $# < 1 || $# > 3 )); then
        printf '用法: proxy <端口> [主机地址 [NO_PROXY]]\n' >&2
        return 2
    fi

    local scheme="http"
    local scheme_socks="socks5"
    local port="$1"
    local host_address="${2:-127.0.0.1}"
    local no_proxy_value="${3:-localhost,127.0.0.1,::1}"

    if [[ ! "$port" =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
        printf '❌ 端口无效: %s\n' "$port" >&2
        return 2
    fi

    local proxy_url="${scheme}://${host_address}:${port}"
    local socks_url="${scheme_socks}://${host_address}:${port}"

    # 常见代理环境变量，小写和大写都设置，兼容更多工具
    export http_proxy="$proxy_url"
    export https_proxy="$proxy_url"
    export socks_proxy="$socks_url"
    export socks5_proxy="$socks_url"
    export all_proxy="$proxy_url"
    export HTTP_PROXY="$proxy_url"
    export HTTPS_PROXY="$proxy_url"
    export SOCKS_PROXY="$socks_url"
    export SOCKS5_PROXY="$socks_url"
    export ALL_PROXY="$proxy_url"
    export no_proxy="$no_proxy_value"
    export NO_PROXY="$no_proxy_value"
    export NODE_USE_ENV_PROXY="1"

    printf '✅ 代理已设置为: %s\n' "$proxy_url"
    printf '   http_proxy  = %s\n' "$http_proxy"
    printf '   https_proxy = %s\n' "$https_proxy"
    printf '   socks_proxy = %s\n' "$socks_proxy"
    printf '   socks5_proxy = %s\n' "$socks5_proxy"
    printf '   all_proxy   = %s\n' "$all_proxy"
    printf '   no_proxy    = %s\n' "$no_proxy"
    curl --fail --silent --show-error 'https://api.ipify.org?format=json'
    printf '\n'
}

unproxy() {
    unset http_proxy https_proxy socks_proxy socks5_proxy all_proxy
    unset HTTP_PROXY HTTPS_PROXY SOCKS_PROXY SOCKS5_PROXY ALL_PROXY
    unset no_proxy NO_PROXY NODE_USE_ENV_PROXY

    printf '✅ 已取消当前 WSL Bash 会话中的代理环境变量。\n'
}

codex-p() {
    if (( $# < 1 )); then
        printf 'usage: codex-p <provider> [codex arguments...]\n' >&2
        return 2
    fi

    local provider="$1"
    shift
    case "$provider" in
        ""|*[![:alnum:]_-]*)
            printf 'codex-p: invalid provider: %s\n' "$provider" >&2
            return 2
            ;;
    esac

    command codex -c "model_provider=\"$provider\"" "$@"
}

codex-env-add() {
    if (( $# != 1 )); then
        printf 'usage: codex-env-add <name>\n' >&2
        return 2
    fi

    local name="$1"
    case "$name" in
        ""|*[![:alnum:]_-]*)
            printf 'codex-env-add: invalid name: %s\n' "$name" >&2
            return 2
            ;;
    esac

    local source_home="$HOME/.codex"
    local profiles_root="$HOME/.codex-env"
    local profile_home="$profiles_root/.codex-$name"
    local alias_name="codex-$name"
    local alias_value='CODEX_HOME="$HOME/.codex-env/.codex-'"$name"'" codex --disable apps'
    local alias_line="alias ${alias_name}='${alias_value}'"
    local aliases_file="${BASH_SOURCE[0]}"
    local managed_start='# >>> dev-env:codex-env aliases >>>'
    local managed_end='# <<< dev-env:codex-env aliases <<<'

    # 集中维护复制排除项：只匹配 CODEX_HOME 根目录的条目，支持 Bash 通配符。
    # 不递归匹配同名内容，避免误删插件、技能和服务内部的数据。
    local -a excluded_entries=(
        # 后台服务、通信文件和进程锁
        'app-server-control'
        'app-server-control.sock'
        'app-server-daemon'
        'thread-writer-locks'
        'mcp-oauth-locks'
        '.sqlite-maintenance.lock'
        'session_index.jsonl.lock'
        # 缓存、临时目录、日志和会话运行数据
        'cache'
        'tmp'
        '.tmp'
        'log'
        'models_cache.json'
        'shell_snapshots'
        'tui-thread-reference-capabilities'
        # 认证文件（不处理 config.toml 内的密钥、环境变量或系统密钥环）
        'auth.json'
        'auth.json.*'
        '.credentials.json'
        '.credentials.json.*'
        # 历史会话、生成图片、记忆、目标和任务队列
        'sessions'
        'archived_sessions'
        'history.jsonl'
        'session_index.jsonl'
        'generated_images'
        'memories'
        # 已知 Codex 数据库；同时排除 -wal、-shm 等伴随文件
        'state_*.sqlite*'
        'thread_history_*.sqlite*'
        'logs_*.sqlite*'
        'memories*.sqlite*'
        'goals_*.sqlite*'
        'queue_*.sqlite*'
    )

    if [[ ! -d "$source_home" ]]; then
        printf 'codex-env-add: source directory does not exist: %s\n' "$source_home" >&2
        return 1
    fi
    if [[ -e "$profile_home" || -L "$profile_home" ]]; then
        printf 'codex-env-add: profile already exists: %s\n' "$profile_home" >&2
        return 1
    fi
    if ! grep -Fqx -- "$managed_start" "$aliases_file" \
        || ! grep -Fqx -- "$managed_end" "$aliases_file"; then
        printf 'codex-env-add: managed alias block is missing: %s\n' "$aliases_file" >&2
        return 1
    fi
    if grep -Fq -- "alias ${alias_name}=" "$aliases_file"; then
        printf 'codex-env-add: alias already exists: %s\n' "$alias_name" >&2
        return 1
    fi

    if ! (umask 077 && mkdir -p -- "$profiles_root"); then
        printf 'codex-env-add: cannot create directory: %s\n' "$profiles_root" >&2
        return 1
    fi
    if ! mkdir -m 700 -- "$profile_home"; then
        printf 'codex-env-add: cannot create profile: %s\n' "$profile_home" >&2
        return 1
    fi
    if ! (
        # 子 Shell 内启用隐藏文件和空目录展开，不改变调用者的 Shell 选项。
        shopt -u failglob
        shopt -s dotglob nullglob
        local entry pattern excluded
        for entry in "$source_home"/*; do
            excluded=false
            for pattern in "${excluded_entries[@]}"; do
                if [[ "${entry##*/}" == $pattern ]]; then
                    excluded=true
                    break
                fi
            done
            if [[ "$excluded" == true ]]; then
                continue
            fi
            cp -a -- "$entry" "$profile_home/" || exit 1
        done
    ); then
        rm -rf -- "$profile_home"
        printf 'codex-env-add: cannot copy profile: %s\n' "$profile_home" >&2
        return 1
    fi

    local temporary
    temporary="$(mktemp "${TMPDIR:-/tmp}/codex-env-aliases.XXXXXX")" || {
        rm -rf -- "$profile_home"
        return 1
    }
    if ! awk -v start="$managed_start" -v line="$alias_line" '
        $0 == start { print; print line; next }
        { print }
    ' "$aliases_file" > "$temporary" || ! cat -- "$temporary" > "$aliases_file"; then
        rm -f -- "$temporary"
        rm -rf -- "$profile_home"
        printf 'codex-env-add: cannot update aliases: %s\n' "$aliases_file" >&2
        return 1
    fi
    rm -f -- "$temporary"

    alias "$alias_name=$alias_value"
    printf 'added %s -> %s\n' "$alias_name" "$profile_home"
}

codex-env-delete() {
    if (( $# != 1 )); then
        printf 'usage: codex-env-delete <name>\n' >&2
        return 2
    fi

    local name="$1"
    case "$name" in
        ""|*[![:alnum:]_-]*)
            printf 'codex-env-delete: invalid name: %s\n' "$name" >&2
            return 2
            ;;
    esac

    local profile_home="$HOME/.codex-env/.codex-$name"
    local alias_name="codex-$name"
    local aliases_file="${BASH_SOURCE[0]}"
    local managed_start='# >>> dev-env:codex-env aliases >>>'
    local managed_end='# <<< dev-env:codex-env aliases <<<'

    if ! grep -Fqx -- "$managed_start" "$aliases_file" \
        || ! grep -Fqx -- "$managed_end" "$aliases_file"; then
        printf 'codex-env-delete: managed alias block is missing: %s\n' "$aliases_file" >&2
        return 1
    fi

    local temporary
    temporary="$(mktemp "${TMPDIR:-/tmp}/codex-env-aliases.XXXXXX")" || return 1
    if ! awk -v start="$managed_start" -v end="$managed_end" -v alias_name="$alias_name" '
        $0 == start { managed = 1; print; next }
        $0 == end { managed = 0; print; next }
        managed && index($0, "alias " alias_name "=") == 1 { next }
        { print }
    ' "$aliases_file" > "$temporary" || ! cat -- "$temporary" > "$aliases_file"; then
        rm -f -- "$temporary"
        printf 'codex-env-delete: cannot update aliases: %s\n' "$aliases_file" >&2
        return 1
    fi
    rm -f -- "$temporary"

    if ! rm -rf -- "$profile_home"; then
        printf 'codex-env-delete: cannot delete profile: %s\n' "$profile_home" >&2
        return 1
    fi
    unalias "$alias_name" 2>/dev/null || true
    printf 'deleted %s and %s\n' "$alias_name" "$profile_home"
}

